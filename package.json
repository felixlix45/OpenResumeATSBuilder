{
  "name": "resume-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ATS-friendly resume builder with true-to-PDF live preview and interactive PDF export",
  "scripts": {
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-ats.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "pdfjs-dist": "5.7.284",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "mupdf": "^1.28.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
